# Учебные настройки. У каждого компьютера свой файл app.env.
# Общая БД: замените 127.0.0.1 на IP компьютера, где запущен PostgreSQL.
DATABASE_URL=postgresql://orders:1234@127.0.0.1:5433/orders_db
# 0.0.0.0 принимает запросы и от соседних компьютеров в Wi-Fi сети.
APP_HOST=0.0.0.0
APP_PORT=8004
HTTP_TIMEOUT=10
ORDER_SERVICE_URL=127.0.0.1:8000
